# Rolewire configuration template.
#
# Nothing here is a real secret. In dev and prod these values are injected by 1Password
# (`op run --env-file=.env.op -- docker compose up`) rather than committed. Generate the two
# cryptographic values with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"          # JWT_SECRET / IP_HASH_SALT
#   python -c "from app.core.crypto import generate_key; print(generate_key())"  # ENCRYPTION_KEY

ENVIRONMENT=dev
LOG_LEVEL=INFO
EXPOSE_DOCS=true

# --- Database / cache -------------------------------------------------------
POSTGRES_PASSWORD=change-me-owner
POSTGRES_APP_PASSWORD=change-me-app
DATABASE_URL=postgresql+asyncpg://rolewire_app:change-me-app@localhost:5432/rolewire
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# --- Auth / crypto ----------------------------------------------------------
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
ENCRYPTION_KEY=
IP_HASH_SALT=

# --- URLs / CORS ------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
ADMIN_ALLOWED_ORIGINS=http://localhost:3000

# --- Public API limits ------------------------------------------------------
PUBLIC_APPLY_RATE_LIMIT=1
PUBLIC_APPLY_RATE_WINDOW_SECONDS=600
PUBLIC_READ_RATE_LIMIT=120
PUBLIC_READ_RATE_WINDOW_SECONDS=60
MAX_UPLOAD_BYTES=10485760

# --- Social login (§5.3) ----------------------------------------------------
OAUTH_GOOGLE_ENABLE=true
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_ENABLE=true
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_FACEBOOK_ENABLE=true
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_LINKEDIN_ENABLE=true
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=

# --- Hosted storage tier (§6) ----------------------------------------------
HOSTED_S3_ENDPOINT=
HOSTED_S3_BUCKET=
HOSTED_S3_REGION=us-east-1
HOSTED_S3_ACCESS_KEY=
HOSTED_S3_SECRET_KEY=

# --- Payments (§9) ----------------------------------------------------------
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
UDDOKTAPAY_API_KEY=
UDDOKTAPAY_WEBHOOK_SECRET=
UDDOKTAPAY_BASE_URL=
GRACE_PERIOD_DAYS=5

# --- Email (§11) -------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=notifications@rolewire.io
SMTP_FROM_NAME=Rolewire

# --- Contact form (admin panel, sends via the same SMTP account) ------------
SUPPORT_INBOX_EMAIL=support@rolewire.io

# --- Admin panel (frontend spec §9) -----------------------------------------
# NEXT_PUBLIC_* values are inlined into the browser bundle at image build time, not read at
# container start — changing one requires rebuilding the `admin` image, not just restarting it.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SUPPORT_EMAIL=support@rolewire.io
